{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning",
        "FluxMonitor": "Debug"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "FluxMonitor": "Debug"
    }
  },
  "Monitor": {
    "Storage": {
      "Provider": "None",
      "ConnectionString": "",
      "Retention": {
        "RawSecondsWindowMinutes": 10,
        "OneMinuteWindowHours": 1,
        "FiveMinuteWindowDays": 7
      }
    },
    "LogStorage": {
      "Enabled": false,
      "ConnectionString": "",
      "AdminConnectionString": "",
      "AutoCreateDatabase": false,
      "SchemaName": "public",
      "TableName": "application_logs"
    },
    "ApiSecurity": {
      "RequireAuthentication": false,
      "TunnelProvider": "none"
    },
    "DeviceDefinitionsPath": "../../../devices",
    "Devices": [
      {
        "DeviceId": "jk-master-01",
        "DisplayName": "Main Battery Rack",
        "DefinitionId": "jk-inverter-bms",
        "Address": 1,
        "IsMaster": true,
        "PollIntervalMilliseconds": 1000,
        "Enabled": true
      }
    ]
  }
}

