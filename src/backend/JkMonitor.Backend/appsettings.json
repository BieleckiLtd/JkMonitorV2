{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Monitor": {
    "SerialBus": {
      "PortName": "/dev/ttyUSB0",
      "BaudRate": 115200,
      "DataBits": 8,
      "Parity": "None",
      "StopBits": "One",
      "ReadTimeoutMilliseconds": 1000,
      "WriteTimeoutMilliseconds": 1000
    },
    "Storage": {
      "Provider": "TimescaleDb",
      "ConnectionString": "Host=localhost;Port=5432;Database=jkmonitor;Username=jkmonitor;Password=change-me",
      "Retention": {
        "RawSecondsWindowMinutes": 10,
        "OneMinuteWindowHours": 1,
        "FiveMinuteWindowDays": 365
      }
    },
    "Alerting": {
      "UiEnabled": true,
      "Ntfy": {
        "BaseUrl": "https://ntfy.sh",
        "Topic": "jkmonitor-alerts"
      }
    },
    "ApiSecurity": {
      "RequireAuthentication": true,
      "TunnelProvider": "cloudflared"
    },
    "Devices": [
      {
        "DeviceId": "jk-master-01",
        "DisplayName": "Main Battery Rack",
        "Protocol": "jk-rs485",
        "RegisterProfile": "jk-inverter-v15",
        "Address": 1,
        "IsMaster": true,
        "PollIntervalMilliseconds": 1000,
        "Enabled": true
      },
      {
        "DeviceId": "jk-slave-01",
        "DisplayName": "Expansion Rack 1",
        "Protocol": "jk-rs485",
        "RegisterProfile": "jk-inverter-v15",
        "Address": 2,
        "IsMaster": false,
        "PollIntervalMilliseconds": 5000,
        "Enabled": true
      }
    ]
  }
}
