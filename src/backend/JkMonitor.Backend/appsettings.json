{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Monitor": {
    "SerialBus": {
      "PortName": "/dev/ttyUSB0",
      "BaudRate": 115200,
      "DataBits": 8,
      "Parity": "None",
      "StopBits": "One",
      "ReadTimeoutMilliseconds": 1000,
      "WriteTimeoutMilliseconds": 1000
    },
    "Storage": {
      "Provider": "TimescaleDb",
      "ConnectionString": "Host=localhost;Database=jkmonitor;Username=jkmonitor;Password=jkmonitor",
      "Retention": {
        "RawSecondsWindowMinutes": 10,
        "OneMinuteWindowHours": 1,
        "FiveMinuteWindowDays": 365,
        "OneHourWindowDays": 0
      }
    },
    "LogStorage": {
      "Enabled": true,
      "ConnectionString": "Host=localhost;Database=jkmonitor_logs;Username=jkmonitor;Password=jkmonitor",
      "AdminConnectionString": "Host=localhost;Database=postgres;Username=jkmonitor;Password=jkmonitor",
      "AutoCreateDatabase": true,
      "SchemaName": "public",
      "TableName": "application_logs"
    },
    "Alerting": {
      "UiEnabled": true,
      "Ntfy": {
        "BaseUrl": "https://ntfy.sh",
        "Topic": "jkmonitor-alerts"
      }
    },
    "ApiSecurity": {
      "RequireAuthentication": true,
      "TunnelProvider": "cloudflared"
    },
    "DeviceDefinitionsPath": "devices",
    "Devices": [
      {
        "DeviceId": "jk-master-01",
        "DisplayName": "Main Battery Rack",
        "DefinitionId": "jk-inverter-bms",
        "TransportPortName": "/dev/ttyUSB0",
        "Address": 1,
        "IsMaster": true,
        "PollIntervalMilliseconds": 1000,
        "Enabled": true,
        "CellVoltageSmoothingFactor": 0.2,
        "CellVoltageSmoothingBreakoutMillivolts": 5,
        "DisplayPrecision": {
          "Voltage": 2,
          "CellVoltage": 3,
          "Current": 1,
          "Power": 0,
          "Temperature": 1,
          "Soc": 0,
          "DeltaVoltage": 3
        }
      }
    ]
  }
}
