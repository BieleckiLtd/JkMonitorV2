<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SourceRevisionId Condition="'$(JkMonitorSourceRevisionId)' != ''">$(JkMonitorSourceRevisionId)</SourceRevisionId>
    <InformationalVersion Condition="'$(JkMonitorReleaseTag)' != '' and '$(JkMonitorSourceRevisionId)' != ''">$(JkMonitorReleaseTag)+$(JkMonitorSourceRevisionId)</InformationalVersion>
    <InformationalVersion Condition="'$(JkMonitorReleaseTag)' != '' and '$(JkMonitorSourceRevisionId)' == ''">$(JkMonitorReleaseTag)</InformationalVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(JkMonitorReleaseTag)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>JkMonitorReleaseTag</_Parameter1>
      <_Parameter2>$(JkMonitorReleaseTag)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup Condition="'$(JkMonitorSourceRevisionId)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>JkMonitorSourceRevisionId</_Parameter1>
      <_Parameter2>$(JkMonitorSourceRevisionId)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup Condition="'$(JkMonitorWorkflowRunNumber)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>JkMonitorWorkflowRunNumber</_Parameter1>
      <_Parameter2>$(JkMonitorWorkflowRunNumber)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup Condition="'$(JkMonitorWorkflowRunAttempt)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>JkMonitorWorkflowRunAttempt</_Parameter1>
      <_Parameter2>$(JkMonitorWorkflowRunAttempt)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup Condition="'$(JkMonitorBuiltAt)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>JkMonitorBuiltAt</_Parameter1>
      <_Parameter2>$(JkMonitorBuiltAt)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>JkMonitor.Backend.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.72" />
    <PackageReference Include="MailKit" Version="4.15.1" />
    <PackageReference Include="MimeKit" Version="4.15.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.5" />
    <PackageReference Include="NCalcSync" Version="5.12.0" />
    <PackageReference Include="Npgsql" Version="10.0.2" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="System.IO.Ports" Version="10.0.5" />
    <PackageReference Include="System.Management" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\shared\JkMonitor.Contracts\JkMonitor.Contracts.csproj" />
  </ItemGroup>

  <!-- Copy device definition JSON files to output so the runtime can find them -->
  <ItemGroup>
    <Content Include="..\..\..\devices\**\*.json" Link="devices\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
