{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning",
        "JkMonitor": "Debug"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "JkMonitor": "Debug"
    }
  },
  "Monitor": {
    "Storage": {
      "Provider": "TimescaleDb",
      "ConnectionString": "Host=localhost;Database=jkmonitor;Username=jkmonitor;Password=jkmonitor",
      "Retention": {
        "RawSecondsWindowMinutes": 10,
        "OneMinuteWindowHours": 1,
        "FiveMinuteWindowDays": 7
      }
    },
    "LogStorage": {
      "Enabled": true,
      "ConnectionString": "Host=localhost;Database=jkmonitor_logs;Username=jkmonitor;Password=jkmonitor",
      "AdminConnectionString": "Host=localhost;Database=postgres;Username=jkmonitor;Password=jkmonitor",
      "AutoCreateDatabase": true,
      "SchemaName": "public",
      "TableName": "application_logs"
    },
    "ApiSecurity": {
      "RequireAuthentication": false,
      "TunnelProvider": "none"
    },
    "DeviceDefinitionsPath": "../../../devices",
    "Devices": [
      {
        "DeviceId": "jk-master-01",
        "DisplayName": "Main Battery Rack",
        "DefinitionId": "jk-inverter-bms",
        "Address": 1,
        "IsMaster": true,
        "PollIntervalMilliseconds": 1000,
        "Enabled": true
      }
    ]
  }
}

