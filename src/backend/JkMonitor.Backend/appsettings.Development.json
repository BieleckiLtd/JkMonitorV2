{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "JkMonitor": "Debug"
    }
  },
  "Monitor": {
    "SerialBus": {
      "PortName": "/dev/ttyUSB0",
      "BaudRate": 115200,
      "DataBits": 8,
      "Parity": "None",
      "StopBits": "One",
      "ReadTimeoutMilliseconds": 1000,
      "WriteTimeoutMilliseconds": 1000
    },
    "Storage": {
      "Retention": {
        "RawSecondsWindowMinutes": 60,
        "OneMinuteWindowHours": 24,
        "FiveMinuteWindowDays": 7
      }
    },
    "Alerting": {
      "UiEnabled": true,
      "Ntfy": {
        "BaseUrl": "https://ntfy.sh",
        "Topic": "jkmonitor-alerts-dev"
      }
    },
    "ApiSecurity": {
      "RequireAuthentication": false,
      "TunnelProvider": "none"
    },
    "Devices": [
      {
        "DeviceId": "jk-master-01",
        "DisplayName": "Main Battery Rack",
        "ProfileId": "jk-inverter-bms",
        "Address": 1,
        "IsMaster": true,
        "PollIntervalMilliseconds": 1000,
        "Enabled": true
      }
    ]
  }
}
