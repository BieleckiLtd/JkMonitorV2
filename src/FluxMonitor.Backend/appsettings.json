{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Monitor": {
    "Storage": {
      "Provider": "TimescaleDb",
      "ConnectionString": "",
      "Retention": {
        "RawSecondsWindowMinutes": 10,
        "OneMinuteWindowHours": 1,
        "FiveMinuteWindowDays": 365,
        "OneHourWindowDays": 0
      },
      "Compression": {
        "CompressAfterMinutes": 60
      }
    },
    "LogStorage": {
      "Enabled": false,
      "ConnectionString": "",
      "AdminConnectionString": "",
      "AutoCreateDatabase": false,
      "SchemaName": "public",
      "TableName": "application_logs"
    },
    "ApiSecurity": {
      "RequireAuthentication": true,
      "TunnelProvider": "cloudflared",
      "CloudflareTunnel": {
        "PublicUrl": ""
      }
    },
    "DeviceDefinitionsPath": "devices",
    "Devices": []
  }
}
