{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "JkMonitor": "Debug"
    }
  },
  "Monitor": {
    "SerialBus": {
      "PortName": "SIMULATED",
      "BaudRate": 115200,
      "DataBits": 8,
      "Parity": "None",
      "StopBits": "One",
      "ReadTimeoutMilliseconds": 250,
      "WriteTimeoutMilliseconds": 250
    },
    "Storage": {
      "Provider": "None",
      "ConnectionString": "",
      "Retention": {
        "RawSecondsWindowMinutes": 10,
        "OneMinuteWindowHours": 1,
        "FiveMinuteWindowDays": 365
      }
    },
    "Simulation": {
      "CellCount": 16,
      "BaseCellMillivolts": 3310,
      "CellSwingMillivolts": 18,
      "BaseStateOfChargePercent": 72,
      "StateOfChargeSwingPercent": 8,
      "MaxCurrentAmps": 42,
      "BaseMosTemperatureCelsius": 29,
      "BaseAmbientTemperatureCelsius": 24,
      "BaseBatteryTemperatureCelsius": 27
    },
    "Alerting": {
      "UiEnabled": true,
      "Ntfy": {
        "BaseUrl": "https://ntfy.sh",
        "Topic": "jkmonitor-alerts-dev"
      }
    },
    "ApiSecurity": {
      "RequireAuthentication": false,
      "TunnelProvider": "none"
    },
    "Devices": [
      {
        "DeviceId": "jk-sim-master-01",
        "DisplayName": "Simulated Main Battery Rack",
        "Protocol": "jk-rs485-simulated",
        "RegisterProfile": "jk-inverter-v15",
        "Address": 1,
        "IsMaster": true,
        "PollIntervalMilliseconds": 1000,
        "Enabled": true
      },
      {
        "DeviceId": "jk-sim-slave-01",
        "DisplayName": "Simulated Expansion Rack 1",
        "Protocol": "jk-rs485-simulated",
        "RegisterProfile": "jk-inverter-v15",
        "Address": 2,
        "IsMaster": false,
        "PollIntervalMilliseconds": 3000,
        "Enabled": true
      }
    ]
  }
}
