{
  "$schema": "https://FluxMonitor.local/schemas/device-definition-v1.json",
  "version": "1",

  "device": {
    "id": "pylon-lv-rs485",
    "name": "Pylon Low Voltage (RS485)",
    "manufacturer": "Generic",
    "model": "Pylon LV Protocol V3.x",
    "category": "energy-storage",
    "description": "Universal definition for BMS using Pylon Low Voltage RS485 protocol V3.x. Compatible with Pylontech, JK BMS, Dali, Deye, Seplos, Pace and other BMS that implement the standard. Supports per-battery commands (V3.3: CID2 0x42, 0x44, 0x92) for individual cell data and system commands (V3.5: CID2 0x61, 0x62, 0x63) for aggregate pack data. Address 2 = master battery in single-group mode. Baud 9600 per V3.5 default (DIP switch 1=UP on Pylontech).",
    "icon": "battery",
    "documentationUrl": "https://github.com/BieleckiLtd/JkMonitorV2"
  },

  "connection": {
    "transport": {
      "type": "serial",
      "defaults": {
        "baudRate": 9600,
        "dataBits": 8,
        "parity": "none",
        "stopBits": 1,
        "readTimeoutMs": 2000,
        "writeTimeoutMs": 1000
      }
    },
    "protocol": {
      "type": "ascii-hex-framed",
      "settings": {
        "defaultSlaveAddress": 2,
        "interFrameDelayMs": 200,
        "retries": 1,
        "byteOrder": "big-endian",
        "asciiHexFrame": {
          "startByte": 126,
          "endByte": 13,
          "version": 32,
          "versionOffsetChars": 0,
          "addressOffsetChars": 2,
          "requestCommandSet": 70,
          "requestCommandSetOffsetChars": 4,
          "commandOffsetChars": 6,
          "lengthOffsetChars": 8,
          "payloadOffsetChars": 12,
          "lengthCharCount": 4,
          "checksumCharCount": 4,
          "lengthEncoding": "nibble-checksum-12bit",
          "frameChecksumType": "ones-complement-sum16",
          "responseSuccessCode": 0
        }
      }
    }
  },

  "dataSources": [
    {
      "id": "analog",
      "name": "Per-Battery Analog (V3.3)",
      "command": 66,
      "pollGroup": "fast",
      "optional": true,
      "requestInfo": "FF",
      "_comment": "CID2 0x42 — individual cell voltages, temperatures, current, voltage, capacity, cycles. INFO=0xFF for system query. Supported by Pylontech US/Force series; NOT supported by some 3rd-party Pylon-mode BMS (e.g. JK BMS returns CID2 Invalid).",
      "responseLayout": {
        "bufferSize": 96,
        "steps": [
          { "op": "skip", "size": 1, "_comment": "INFOFLAG byte" },
          { "op": "readVar", "var": "modules", "type": "u8" },
          { "op": "firstOf", "var": "modules", "steps": [
            { "op": "readVar", "var": "cells", "type": "u8", "writeTo": 64 },
            { "op": "copyArray", "count": "cells", "elementSize": 2, "writeTo": 0, "max": 32 },
            { "op": "readVar", "var": "temps", "type": "u8", "writeTo": 76 },
            { "op": "copyArray", "count": "temps", "elementSize": 2, "writeTo": 66, "max": 5 },
            { "op": "copy", "size": 2, "writeTo": 78, "_comment": "current (int16, value*100=mA → scale 0.1A)" },
            { "op": "copy", "size": 2, "writeTo": 80, "_comment": "module voltage (uint16, mV)" },
            { "op": "readVar", "var": "rc1", "type": "u16" },
            { "op": "readVar", "var": "udef", "type": "u8", "writeTo": 92 },
            { "op": "readVar", "var": "tc1", "type": "u16" },
            { "op": "copy", "size": 2, "writeTo": 90, "_comment": "cycle count" },
            { "op": "branch", "var": "udef", "gt": 2,
              "then": [
                { "op": "readVar", "var": "rc2", "type": "u24", "writeTo": 82, "writeAs": "u32" },
                { "op": "skip", "size": 2 },
                { "op": "readVar", "var": "tc2", "type": "u24", "writeTo": 86, "writeAs": "u32" }
              ],
              "else": [
                { "op": "writeVar", "var": "rc1", "writeTo": 82, "writeAs": "u32" },
                { "op": "writeVar", "var": "tc1", "writeTo": 86, "writeAs": "u32" }
              ]
            }
          ]}
        ]
      }
    },
    {
      "id": "alarm",
      "name": "Per-Battery Alarm (V3.3)",
      "command": 68,
      "pollGroup": "fast",
      "optional": true,
      "requestInfo": "FF",
      "_comment": "CID2 0x44 — per-cell voltage alarm, temperature alarm, current/voltage alarm, status flags",
      "responseLayout": {
        "bufferSize": 16,
        "steps": [
          { "op": "skip", "size": 2, "_comment": "DATAFLAG + command byte" },
          { "op": "readVar", "var": "cells", "type": "u8", "writeTo": 0 },
          { "op": "readAnyNonZero", "count": "cells", "writeTo": 8 },
          { "op": "readVar", "var": "temps", "type": "u8", "writeTo": 1 },
          { "op": "readAnyNonZero", "count": "temps", "writeTo": 9 },
          { "op": "readByte", "writeTo": 10 },
          { "op": "readByte", "writeTo": 11 },
          { "op": "readByte", "writeTo": 12 },
          { "op": "readByte", "writeTo": 13 },
          { "op": "readByte", "writeTo": 14 },
          { "op": "readByte", "writeTo": 15 }
        ]
      }
    },
    {
      "id": "per_battery_mgmt",
      "name": "Per-Battery Management (V3.3)",
      "command": 146,
      "pollGroup": "slow",
      "optional": true,
      "requestInfo": "FF",
      "_comment": "CID2 0x92 — per-battery charge/discharge voltage/current limits and enable flags",
      "responseLayout": {
        "bufferSize": 12,
        "steps": [
          { "op": "skip", "size": 1, "_comment": "command byte" },
          { "op": "copy", "size": 2, "writeTo": 0 },
          { "op": "copy", "size": 2, "writeTo": 2 },
          { "op": "copy", "size": 2, "writeTo": 4 },
          { "op": "copy", "size": 2, "writeTo": 6 },
          { "op": "readVar", "var": "status", "type": "u8" },
          { "op": "writeBit", "var": "status", "bit": 7, "writeTo": 8 },
          { "op": "writeBit", "var": "status", "bit": 6, "writeTo": 9 }
        ]
      }
    },
    {
      "id": "system_analog",
      "name": "System Analog (V3.5)",
      "command": 97,
      "pollGroup": "fast",
      "optional": true,
      "_comment": "CID2 0x61 — V3.5 system aggregate: avg voltage, total current, SOC, cycles, SOH, max/min cell V with module, cell/MOSFET/BMS temperatures. 49-byte payload, straight copy.",
      "responseLayout": {
        "bufferSize": 49,
        "steps": [
          { "op": "copy", "size": 49, "writeTo": 0 }
        ]
      }
    },
    {
      "id": "system_alarm",
      "name": "System Alarm (V3.5)",
      "command": 98,
      "pollGroup": "fast",
      "optional": true,
      "_comment": "CID2 0x62 — V3.5 system alarm + protection status (4 bytes, bit flags)",
      "responseLayout": {
        "bufferSize": 4,
        "steps": [
          { "op": "copy", "size": 4, "writeTo": 0 }
        ]
      }
    },
    {
      "id": "system_mgmt",
      "name": "System Management (V3.5)",
      "command": 99,
      "pollGroup": "slow",
      "optional": true,
      "_comment": "CID2 0x63 — V3.5 system charge/discharge limits and enable flags. Current scale 0.1A (V3.3 convention, verified with JK BMS; V3.5 spec example suggests 0.01A for Pylontech batteries).",
      "responseLayout": {
        "bufferSize": 12,
        "steps": [
          { "op": "copy", "size": 2, "writeTo": 0 },
          { "op": "copy", "size": 2, "writeTo": 2 },
          { "op": "copy", "size": 2, "writeTo": 4 },
          { "op": "copy", "size": 2, "writeTo": 6 },
          { "op": "readVar", "var": "status", "type": "u8" },
          { "op": "writeBit", "var": "status", "bit": 7, "writeTo": 8 },
          { "op": "writeBit", "var": "status", "bit": 6, "writeTo": 9 },
          { "op": "writeBit", "var": "status", "bit": 5, "writeTo": 10 },
          { "op": "writeBit", "var": "status", "bit": 4, "writeTo": 11 }
        ]
      }
    }
  ],

  "pollGroups": {
    "fast": {
      "intervalMs": 2000,
      "description": "Real-time telemetry — pack status, cell data, alarms"
    },
    "slow": {
      "intervalMs": 60000,
      "description": "Charge/discharge limits (slow-changing)"
    }
  },

