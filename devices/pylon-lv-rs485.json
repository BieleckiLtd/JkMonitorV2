      "name": "Discharging (per-battery)",
      "category": "Status",
      "source": {
        "bank": "per_battery_mgmt",
        "byteOffset": 9,
        "dataType": "uint8",
        "trueValue": 1
      },
      "hidden": true,
      "_comment": "writeBit bit:6 → byte 9 (0 or 1)"
    },
    {
      "id": "pb_charge_voltage_limit",
      "type": "sensor",
      "name": "Charge Voltage Limit (per-battery)",
      "category": "Limits",
      "source": {
        "bank": "per_battery_mgmt",
        "byteOffset": 0,
        "dataType": "uint16",
        "scale": 0.001,
        "unit": "V"
      },
      "display": { "precision": 2 },
      "hidden": true
    },
    {
      "id": "pb_discharge_voltage_limit",
      "type": "sensor",
      "name": "Discharge Voltage Limit (per-battery)",
      "category": "Limits",
      "source": {
        "bank": "per_battery_mgmt",
        "byteOffset": 2,
        "dataType": "uint16",
        "scale": 0.001,
        "unit": "V"
      },
      "display": { "precision": 2 },
      "hidden": true
    },
    {
      "id": "pb_charge_current_limit",
      "type": "sensor",
      "name": "Charge Current Limit (per-battery)",
      "category": "Limits",
      "source": {
        "bank": "per_battery_mgmt",
        "byteOffset": 4,
        "dataType": "int16",
        "scale": 0.1,
        "unit": "A"
      },
      "display": { "precision": 1 },
      "hidden": true
    },
    {
      "id": "pb_discharge_current_limit",
      "type": "sensor",
      "name": "Discharge Current Limit (per-battery)",
      "category": "Limits",
      "source": {
        "bank": "per_battery_mgmt",
        "byteOffset": 6,
        "dataType": "int16",
        "scale": 0.1,
        "unit": "A"
      },
      "display": { "precision": 1 },
      "hidden": true
    },

    {
      "_comment": "=== System Management (CID2=0x63, V3.5) — responseLayout extracts each status bit into its own byte ===",
      "id": "charging_enabled",
      "type": "binary_sensor",
      "name": "Charging",
      "category": "Status",
      "source": {
        "bank": "system_mgmt",
        "byteOffset": 8,
        "dataType": "uint8",
        "trueValue": 1
      },
      "role": "charging-enabled"
    },
    {
      "id": "discharging_enabled",
      "type": "binary_sensor",
      "name": "Discharging",
      "category": "Status",
      "source": {
        "bank": "system_mgmt",
        "byteOffset": 9,
        "dataType": "uint8",
        "trueValue": 1
      },
      "role": "discharging-enabled"
    },
    {
      "id": "charge_immediately",
      "type": "binary_sensor",
      "name": "Charge Immediately",
      "category": "Status",
      "source": {
        "bank": "system_mgmt",
        "byteOffset": 10,
        "dataType": "uint8",
        "trueValue": 1
      }
    },
    {
      "id": "full_charge_request",
      "type": "binary_sensor",
      "name": "Full Charge Request",
      "category": "Status",
      "source": {
        "bank": "system_mgmt",
        "byteOffset": 11,
        "dataType": "uint8",
        "trueValue": 1
      }
    },
    {
      "id": "charge_voltage_limit",
      "type": "sensor",
      "name": "Charge Voltage Limit",
      "category": "Limits",
      "source": {
        "bank": "system_mgmt",
        "byteOffset": 0,
        "dataType": "uint16",
        "scale": 0.001,
        "unit": "V"
      },
      "display": { "precision": 2 }
    },
    {
      "id": "discharge_voltage_limit",
      "type": "sensor",
      "name": "Discharge Voltage Limit",
      "category": "Limits",
      "source": {
        "bank": "system_mgmt",
        "byteOffset": 2,
        "dataType": "uint16",
        "scale": 0.001,
        "unit": "V"
      },
      "display": { "precision": 2 }
    },
    {
      "id": "charge_current_limit",
      "type": "sensor",
      "name": "Charge Current Limit",
      "category": "Limits",
      "source": {
        "bank": "system_mgmt",
        "byteOffset": 4,
        "dataType": "int16",
        "scale": 0.1,
        "unit": "A"
      },
      "display": { "precision": 1 },
      "_comment": "Scale 0.1A (V3.3 convention, verified with JK BMS). V3.5 Pylontech example suggests 0.01A — adjust if using native Pylontech batteries."
    },
    {
      "id": "discharge_current_limit",
      "type": "sensor",
      "name": "Discharge Current Limit",
      "category": "Limits",
      "source": {
        "bank": "system_mgmt",
        "byteOffset": 6,
        "dataType": "int16",
        "scale": 0.1,
        "unit": "A"
      },
      "display": { "precision": 1 }
    }
  ],

  "computedEntities": [
    {
      "_comment": "=== Temperature Conversions (Kelvin*10 → °C) ===",
      "id": "battery_temp_1",
      "type": "sensor",
      "name": "Avg Cell Temperature",
      "category": "Temperatures",
      "expression": "sys_avg_cell_temp_raw - 273.1",
      "unit": "°C",
      "display": { "precision": 1 },
      "role": "battery-temperature",
      "_comment": "Source: V3.5 system avg cell temp."
    },
    {
      "id": "max_cell_temp_celsius",
      "type": "sensor",
      "name": "Max Cell Temperature",
      "category": "Temperatures",
      "expression": "sys_max_cell_temp_raw - 273.1",
      "unit": "°C",
      "display": { "precision": 1 }
    },
    {
      "id": "min_cell_temp_celsius",
      "type": "sensor",
      "name": "Min Cell Temperature",
      "category": "Temperatures",
      "expression": "sys_min_cell_temp_raw - 273.1",
      "unit": "°C",
      "display": { "precision": 1 }
    },
    {
      "id": "mos_temperature",
      "type": "sensor",
      "name": "MOSFET Temperature",
      "category": "Temperatures",
      "expression": "sys_mosfet_avg_temp_raw - 273.1",
      "unit": "°C",
      "display": { "precision": 1 },
      "role": "mos-temperature"
    },
    {
      "id": "mosfet_max_temp_celsius",
      "type": "sensor",
      "name": "MOSFET Max Temperature",
      "category": "Temperatures",
      "expression": "sys_mosfet_max_temp_raw - 273.1",
      "unit": "°C",
      "display": { "precision": 1 },
      "hidden": true
    },
    {
      "id": "bms_temperature_celsius",
      "type": "sensor",
      "name": "BMS Temperature",
      "category": "Temperatures",
      "expression": "sys_bms_avg_temp_raw - 273.1",
      "unit": "°C",
      "display": { "precision": 1 }
    },
    {
      "id": "bms_max_temp_celsius",
      "type": "sensor",
      "name": "BMS Max Temperature",
      "category": "Temperatures",
      "expression": "sys_bms_max_temp_raw - 273.1",
      "unit": "°C",
      "display": { "precision": 1 },
      "hidden": true
    },

    {
      "_comment": "=== Per-Battery Temperature Fallbacks ===",
      "id": "pb_bms_temp_celsius",
      "type": "sensor",
      "name": "BMS Temperature (per-battery)",
      "category": "Temperatures",
      "expression": "pb_bms_temp_raw - 273.1",
      "unit": "°C",
      "display": { "precision": 1 },
      "role": "temperature",
      "hidden": true,
      "_comment": "Role fallback: if system_analog fails and per-battery analog provides BMS temp, builder finds this via role search."
    },
    {
      "id": "pb_cell_temp_1_celsius",
      "type": "sensor",
      "name": "Cell Group Temp 1 (per-battery)",
      "category": "Temperatures",
      "expression": "pb_cell_temp_1_raw - 273.1",
      "unit": "°C",
      "display": { "precision": 1 },
      "hidden": true
    },
    {
      "id": "pb_cell_temp_2_celsius",
      "type": "sensor",
      "name": "Cell Group Temp 2 (per-battery)",
      "category": "Temperatures",
      "expression": "pb_cell_temp_2_raw - 273.1",
      "unit": "°C",
      "display": { "precision": 1 },
      "hidden": true
    },

    {
      "_comment": "=== Power & Cell Stats ===",
      "id": "computed_power",
      "type": "sensor",
      "name": "Power",
      "category": "Pack Status",
      "expression": "total_voltage * current",
      "unit": "W",
      "display": { "precision": 0 },
      "role": "power"
    },
    {
      "id": "avg_cell_voltage",
      "type": "sensor",
      "name": "Avg Cell Voltage",
      "category": "Cells",
      "expression": "avg(cell_voltages)",
      "unit": "V",
      "display": { "precision": 3 },
      "role": "average-cell-voltage",
      "_comment": "Only available when per-battery CID2=0x42 responds (individual cell data)."
    },
    {
      "id": "delta_cell_voltage",
      "type": "sensor",
      "name": "Cell Delta Voltage",
      "category": "Cells",
      "expression": "max_cell_voltage - min_cell_voltage",
      "unit": "V",
      "display": { "precision": 3 },
      "role": "delta-cell-voltage"
    },

    {
      "_comment": "=== Alarm Flags ===",
      "id": "alarm_flags",
      "type": "sensor",
      "name": "System Alarm Flags",
      "category": "Diagnostics",
      "expression": "sys_alarm_status_1 + sys_alarm_status_2 * 256 + sys_protection_status_1 * 65536 + sys_protection_status_2 * 16777216",
      "display": { "format": "hex" },
      "role": "alarm-flags",
      "hidden": true
    },
    {
      "id": "pb_alarm_flags",
      "type": "sensor",
      "name": "Per-Battery Alarm Flags",
      "category": "Diagnostics",
      "expression": "pb_cell_voltage_alarm * 1 + pb_temperature_alarm * 2 + pb_current_alarm * 4 + pb_voltage_alarm * 8",
      "display": { "format": "hex" },
      "hidden": true
    }
  ],

  "alarms": {
    "source": "alarm_flags",
    "type": "bitmask",
    "bits": [
      { "bit": 0, "name": "Cell voltage consistency alarm",       "severity": "warning" },
      { "bit": 1, "name": "MOSFET high temperature alarm",        "severity": "critical" },
      { "bit": 2, "name": "Cell low temperature alarm",           "severity": "warning" },
      { "bit": 3, "name": "Cell high temperature alarm",          "severity": "critical" },
      { "bit": 4, "name": "Cell under voltage alarm",             "severity": "critical" },
      { "bit": 5, "name": "Cell over voltage alarm",              "severity": "critical" },
      { "bit": 6, "name": "Module under voltage alarm",           "severity": "critical" },
      { "bit": 7, "name": "Module over voltage alarm",            "severity": "critical" },
      { "bit": 8, "name": "Cell temperature consistency alarm",   "severity": "warning" },
      { "bit": 9, "name": "Charge over current alarm",            "severity": "critical" },
      { "bit": 10, "name": "Discharge over current alarm",        "severity": "critical" },
      { "bit": 11, "name": "Internal communication error",        "severity": "critical" },
      { "bit": 17, "name": "MOSFET over temperature protection",  "severity": "critical" },
      { "bit": 18, "name": "Cell under temperature protection",   "severity": "critical" },
      { "bit": 19, "name": "Cell over temperature protection",    "severity": "critical" },
      { "bit": 20, "name": "Cell under voltage protection",       "severity": "critical" },
      { "bit": 21, "name": "Cell over voltage protection",        "severity": "critical" },
      { "bit": 22, "name": "Module under voltage protection",     "severity": "critical" },
      { "bit": 23, "name": "Module over voltage protection",      "severity": "critical" },
      { "bit": 25, "name": "Charge over current protection",      "severity": "critical" },
      { "bit": 26, "name": "Discharge over current protection",   "severity": "critical" },
      { "bit": 27, "name": "System fault protection",             "severity": "critical" }
    ]
  },

  "storage": {
    "database": {
      "provider": "timescaledb",
      "defaultNamePattern": "FluxMonitor_{deviceId}"
    },
    "timeSeries": [
      { "entity": "total_voltage",           "aggregate": "avg",  "column": "total_voltage_v" },
      { "entity": "current",                 "aggregate": "avg",  "column": "current_a" },
      { "entity": "computed_power",          "aggregate": "avg",  "column": "power_w" },
      { "entity": "state_of_charge",         "aggregate": "last", "column": "soc_pct" },
      { "entity": "min_cell_voltage",        "aggregate": "min",  "column": "min_cell_v" },
      { "entity": "max_cell_voltage",        "aggregate": "max",  "column": "max_cell_v" },
      { "entity": "delta_cell_voltage",      "aggregate": "avg",  "column": "delta_cell_v" },
      { "entity": "battery_temp_1",          "aggregate": "avg",  "column": "bms_temp_c" },
      { "entity": "mos_temperature",         "aggregate": "avg",  "column": "mosfet_temp_c" },
      { "entity": "avg_soh",                 "aggregate": "last", "column": "soh_pct" }
    ],
    "cellVoltages": {
      "entity": "cell_voltages",
      "aggregate": "avg"
    },
    "retention": {
      "raw":  { "window": "24h" },
      "1m":   { "window": "1y" },
      "5m":   { "window": "1y" },
      "1h":   { "window": "10y" }
    }
  },

  "ui": {
    "pages": {
      "monitor": {
        "sections": [
          {
            "type": "hero-metrics",
            "metrics": [
              { "entity": "total_voltage",    "icon": "zap",      "color": "emerald" },
              { "entity": "current",          "icon": "activity",  "color": "blue" },
              { "entity": "computed_power",   "icon": "gauge",     "color": "amber" },
              { "entity": "state_of_charge",  "icon": "battery",   "color": "green" }
            ]
          },
          {
            "type": "status-indicators",
            "entities": ["charging_enabled", "discharging_enabled", "charge_immediately", "full_charge_request"]
          },
          {
            "type": "cell-chart",
            "entity": "cell_voltages",
            "showStats": true,
            "showDelta": true,
            "stats": ["min_cell_voltage", "max_cell_voltage", "avg_cell_voltage", "delta_cell_voltage"]
          },
          {
            "type": "parameter-table",
            "title": "Pack Status",
            "filter": { "categories": ["Pack Status"] },
            "groupBy": "category"
          },
          {
            "type": "parameter-table",
            "title": "Temperatures",
            "filter": { "categories": ["Temperatures"] },
            "groupBy": "category"
          },
          {
            "type": "parameter-table",
            "title": "Limits",
            "filter": { "categories": ["Limits"] },
            "groupBy": "category"
          }
        ]
      },
      "history": {
        "resolutions": [
          { "id": "1s", "label": "1 Second",  "defaultWindow": "10m" },
          { "id": "1m", "label": "1 Minute",  "defaultWindow": "1h" },
          { "id": "5m", "label": "5 Minutes", "defaultWindow": "24h" },
          { "id": "1h", "label": "1 Hour",    "defaultWindow": "7d" }
        ],
        "charts": [
          {
            "title": "Current",
            "type": "line-chart",
            "traces": [
              { "entity": "current", "label": "Current", "color": "blue" },
              { "entity": "total_voltage", "label": "Pack Voltage", "color": "emerald", "secondaryAxis": true }
            ],
            "yAxis": { "unit": "A", "label": "Current" }
          },
          {
            "title": "Energy",
            "type": "area-chart",
            "traces": [
              { "entity": "computed_power", "color": "amber", "positiveLabel": "Charging", "negativeLabel": "Discharging" }
            ],
            "yAxis": { "unit": "W", "label": "Power" },
            "showEnergyTotals": true
          },
          {
            "title": "State of Charge",
            "type": "line-chart",
            "traces": [
              { "entity": "state_of_charge", "label": "SOC", "color": "green" }
            ],
            "yAxis": { "unit": "%", "label": "SOC", "domain": [0, 100] }
          },
          {
            "title": "Temperatures",
            "type": "line-chart",
            "traces": [
              { "entity": "battery_temp_1",          "label": "Cell Avg",    "color": "red" },
              { "entity": "mos_temperature",         "label": "MOSFET",      "color": "orange" },
              { "entity": "bms_temperature_celsius", "label": "BMS",         "color": "yellow" }
            ],
            "yAxis": { "unit": "°C", "label": "Temperature" }
          },
          {
            "title": "Cell Voltage Spread",
            "type": "line-chart",
            "traces": [
              { "entity": "min_cell_voltage", "label": "Min",   "color": "red" },
              { "entity": "max_cell_voltage", "label": "Max",   "color": "emerald" },
              { "entity": "avg_cell_voltage", "label": "Avg",   "color": "blue", "dashed": true }
            ],
            "yAxis": { "unit": "V", "label": "Cell Voltage" }
          },
          {
            "title": "Cell Voltages",
            "type": "multi-cell-chart",
            "entity": "cell_voltages",
            "selectable": true
          }
        ]
      },
      "dashboard": {
        "card": {
          "primaryMetric": "state_of_charge",
          "secondaryMetrics": ["total_voltage", "current", "computed_power"],
          "statusEntities": ["charging_enabled", "discharging_enabled"]
        }
      }
    }
  },

  "notifications": {
    "rules": [
      {
        "id": "low-soc",
        "name": "Low Battery",
        "condition": { "entity": "state_of_charge", "operator": "<", "value": 10 },
        "severity": "critical",
        "message": "Battery critically low: {state_of_charge}%",
        "cooldownMinutes": 15
      },
      {
        "id": "high-cell-temp",
        "name": "High Cell Temperature",
        "condition": { "entity": "max_cell_temp_celsius", "operator": ">", "value": 50 },
        "severity": "warning",
        "message": "Cell temperature high: {max_cell_temp_celsius}°C",
        "cooldownMinutes": 30
      },
      {
        "id": "high-mosfet-temp",
        "name": "High MOSFET Temperature",
        "condition": { "entity": "mos_temperature", "operator": ">", "value": 80 },
        "severity": "critical",
        "message": "MOSFET temperature critical: {mos_temperature}°C",
        "cooldownMinutes": 15
      },
      {
        "id": "high-delta",
        "name": "Cell Imbalance",
        "condition": { "entity": "delta_cell_voltage", "operator": ">", "value": 0.05 },
        "severity": "warning",
        "message": "Cell imbalance detected: delta {delta_cell_voltage}V",
        "cooldownMinutes": 60
      },
      {
        "id": "alarm-active",
        "name": "System Alarm",
        "condition": { "entity": "alarm_flags", "operator": "!=", "value": 0 },
        "severity": "critical",
        "message": "Active system alarm detected",
        "cooldownMinutes": 5
      }
    ]
  }
}
