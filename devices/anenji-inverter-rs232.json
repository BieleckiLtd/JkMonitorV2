{
  "$schema": "https://FluxMonitor.local/schemas/device-definition-v1.json",
  "version": "1",
  "device": {
    "id": "anenji-inverter-rs232",
    "name": "Anenji / Easun SMG-II Inverter",
    "manufacturer": "Anenji / Easun",
    "model": "ANJ-HHS-11000W-48V / ISolar-SMG-II-11KW-48V",
    "category": "inverter",
    "description": "Anenji ANJ-HHS-11000W-48V and Easun ISolar-SMG-II-11KW-48V-WiFi hybrid solar inverters. Uses Modbus RTU over RS232 (MAX3232 level converter on Pi GPIO UART). Register layout is firmware-specific: settings at 600+ range, live battery at 277-281, live AC at 338-349.",
    "icon": "zap",
    "documentationUrl": "https://github.com/BieleckiLtd/JkMonitorV2"
  },
  "connection": {
    "transport": {
      "type": "serial",
      "defaults": {
        "baudRate": 9600,
        "dataBits": 8,
        "parity": "none",
        "stopBits": 1,
        "readTimeoutMs": 2000,
        "writeTimeoutMs": 1000
      }
    },
    "protocol": {
      "type": "modbus-rtu",
      "settings": {
        "defaultSlaveAddress": 1,
        "interFrameDelayMs": 100,
        "retries": 1
      }
    }
  },
  "dataSources": [
    {
      "_comment": "Regs 196-212: operating mode, frequency, grid power, AC charging power",
      "id": "live_main",
      "name": "Live – Status & Frequency",
      "address": 196,
      "count": 17,
      "functionCode": 3,
      "pollGroup": "fast"
    },
    {
      "_comment": "Regs 223-232: PV power, load%, output freq, INV temperature",
      "id": "live_solar",
      "name": "Live – Solar & Load",
      "address": 223,
      "count": 10,
      "functionCode": 3,
      "pollGroup": "fast"
    },
    {
      "_comment": "Regs 277-281: battery V/I/P/SOC/DC temp",
      "id": "live_battery",
      "name": "Live – Battery",
      "address": 277,
      "count": 5,
      "functionCode": 3,
      "pollGroup": "fast"
    },
    {
      "_comment": "Reg 305: PV temperature",
      "id": "live_pv_temp",
      "name": "Live – PV Temperature",
      "address": 305,
      "count": 1,
      "functionCode": 3,
      "pollGroup": "fast"
    },
    {
      "_comment": "Regs 338-349: grid voltage, grid power, output V/I/P/VA",
      "id": "live_ac",
      "name": "Live – AC Measurements",
      "address": 338,
      "count": 12,
      "functionCode": 3,
      "pollGroup": "fast"
    },
    {
      "_comment": "Regs 601-689: all user-configurable settings (output/charge priority, voltages, currents, mode toggles)",
      "id": "settings",
      "name": "Settings",
      "address": 601,
      "count": 89,
      "functionCode": 3,
      "pollGroup": "slow",
      "write": {
        "functionCode": 16,
        "registersPerWrite": 1
      }
    },
    {
      "_comment": "Regs 171-192: equipment type (171), serial number ASCII (186-192)",
      "id": "info_id",
      "name": "Device Identity",
      "address": 171,
      "count": 22,
      "functionCode": 3,
      "pollGroup": "slow"
    },
    {
      "_comment": "Regs 691-761: rated power (691), firmware version ASCII (754-761)",
      "id": "info_fw",
      "name": "Device Firmware",
      "address": 691,
      "count": 71,
      "functionCode": 3,
      "pollGroup": "slow"
    },
    {
      "_comment": "Regs 971-986: BMS communication data (charge request V, discharge cutoff V, current limits)",
      "id": "bms_data",
      "name": "BMS Data",
      "address": 971,
      "count": 16,
      "functionCode": 3,
      "pollGroup": "fast"
    }
  ],
  "pollGroups": {
    "fast": {
      "intervalMs": 5000,
      "description": "Live measurements — battery, grid, output, temperatures"
    },
    "slow": {
      "intervalMs": 30000,
      "description": "Settings, device info (slow-changing)"
    }
  },
