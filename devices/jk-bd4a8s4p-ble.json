{
  "$schema": "https://FluxMonitor.local/schemas/device-definition-v1.json",
  "version": "1",

  "device": {
    "id": "jk-bd4a8s4p-ble",
    "name": "JK BD4A8S4P BMS (BLE)",
    "manufacturer": "JK",
    "model": "JK-BD4A8S4P",
    "category": "energy-storage",
    "description": "JK BD4A8S4P BMS with Bluetooth Low Energy interface for 4S 8P LiFePO4 battery packs. Supports charge/discharge/balance control and comprehensive protection. Connects wirelessly via BLE GATT service 0xFFE0.",
    "icon": "battery",
    "documentationUrl": "https://github.com/BieleckiLtd/JkMonitorV2"
  },

  "connection": {
    "transport": {
      "type": "ble",
      "defaults": {
        "serviceUuid": "0000ffe0-0000-1000-8000-00805f9b34fb",
        "notifyCharacteristicUuid": "0000ffe1-0000-1000-8000-00805f9b34fb",
        "writeCharacteristicUuid": "0000ffe1-0000-1000-8000-00805f9b34fb",
        "connectionTimeoutMs": 20000,
        "reconnectDelayMs": 5000
      }
    },
    "protocol": {
      "type": "ble-frame",
      "settings": {
        "byteOrder": "little-endian",
        "requestFrameSize": 20,
        "responseFrameSize": 300,
        "checksumType": "sum8",
        "retries": 1,
        "requestPreamble": [170, 85, 144, 235],
        "responsePreamble": [85, 170, 235, 144],
        "commandOffset": 4,
        "responseFrameTypeOffset": 4,
        "responseFooterSize": 1,
        "writeRegisterOffset": 4,
        "writeValueLengthOffset": 5,
        "writeValueOffset": 6,
        "writeValueByteOrder": "little-endian",
        "interBankDelayMs": 2500
      }
    }
  },

  "dataSources": [
    {
      "id": "config",
      "name": "Configuration",
      "command": 150,
      "responseFrameType": 1,
      "headerSize": 6,
      "pollGroup": "slow",
      "write": {
        "type": "frame-register",
        "addressBase": 1,
        "addressStepBytes": 4
      }
    },
    {
      "id": "live",
      "name": "Live Data",
      "command": 151,
      "responseFrameType": 2,
      "headerSize": 6,
      "pollGroup": "fast"
    },
    {
      "id": "info",
      "name": "Device Information",
      "command": 151,
      "responseFrameType": 3,
      "headerSize": 6,
      "optional": true,
      "pollGroup": "slow"
    }
  ],

  "pollGroups": {
    "fast": {
      "intervalMs": 1000,
      "description": "Real-time sensor data — cell voltages, pack status, temperatures"
    },
    "slow": {
      "intervalMs": 30000,
      "description": "Configuration parameters and device info (slow-changing)"
    }
  },

  "entities": [
    {
      "_comment": "=== LIVE DATA — Cell Voltages ===",
      "id": "cell_voltages",
      "type": "cell_array",
      "name": "Cell Voltages",
      "category": "Cells",
      "source": {
        "bank": "live",
        "byteOffset": 0,
        "elementDataType": "uint16",
        "elementByteSize": 2,
        "maxElements": 32,
        "skipZero": true,
        "scale": 0.001,
        "unit": "V"
      },
      "display": {
        "precision": 3,
        "format": "number"
      },
      "role": "cell-voltages"
    },

    {
      "_comment": "=== LIVE DATA — Cell Status ===",
      "id": "cell_status",
