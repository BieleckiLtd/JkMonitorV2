{
  "$schema": "https://FluxMonitor.local/schemas/device-definition-v1.json",
  "version": "1",
  "device": {
    "id": "govee-thermo-hygrometer-ble",
    "name": "Govee Thermo-Hygrometer (BLE)",
    "manufacturer": "Govee",
    "model": "H5075 family",
    "category": "environment",
    "description": "Passive BLE broadcaster profile for Govee thermo-hygrometers that advertise temperature, humidity, and battery values in manufacturer data.",
    "icon": "data:image/png;base64,",
    "documentationUrl": "https://github.com/BieleckiLtd/JkMonitorV2"
  },
  "connection": {
    "transport": {
      "type": "ble",
      "defaults": {}
    },
    "protocol": {
      "type": "ble-advertisement",
      "settings": {
        "advertisement": {
          "payloadSource": "manufacturer-data",
          "manufacturerId": 60552,
          "localNamePrefix": "GVH",
          "payloadOffset": 0,
          "payloadLength": 0,
          "scanWindowMs": 4000,
          "freshnessMs": 15000
        }
      }
    }
  },
  "dataSources": [
    {
      "id": "broadcast",
      "name": "Broadcast payload",
      "pollGroup": "fast",
      "responseLayout": {
        "bufferSize": 5,
        "steps": [
          { "op": "skip", "size": 1 },
          { "op": "readVar", "type": "u24", "var": "encoded" },
          { "op": "readVar", "type": "u8", "var": "battery", "writeTo": 4, "writeAs": "u8" },
          { "op": "mathAnd", "var": "encoded", "value": 8388608, "targetVar": "sign_bit" },
          {
            "op": "branch",
            "var": "sign_bit",
            "gt": 0,
            "then": [
              { "op": "mathXor", "var": "encoded", "value": 8388608, "targetVar": "encoded_unsigned" },
              { "op": "mathDiv", "var": "encoded_unsigned", "value": 1000, "targetVar": "temperature_tenths" },
              { "op": "mathMul", "var": "temperature_tenths", "value": -1 },
              { "op": "mathMod", "var": "encoded_unsigned", "value": 1000, "targetVar": "humidity_tenths" }
            ],
            "else": [
              { "op": "mathDiv", "var": "encoded", "value": 1000, "targetVar": "temperature_tenths" },
              { "op": "mathMod", "var": "encoded", "value": 1000, "targetVar": "humidity_tenths" }
            ]
          },
          { "op": "writeVar", "var": "temperature_tenths", "writeTo": 0, "writeAs": "i16" },
          { "op": "writeVar", "var": "humidity_tenths", "writeTo": 2, "writeAs": "u16" }
        ]
      }
    }
  ],
  "pollGroups": {
    "fast": {
      "intervalMs": 5000,
      "description": "Passive BLE advertisements sampled from the nearby broadcaster."
    }
  },
  "entities": [
    {
      "id": "temperature_c",
      "type": "sensor",
      "name": "Temperature",
      "category": "Environment",
      "icon": "thermometer",
      "source": {
        "bank": "broadcast",
        "byteOffset": 0,
        "dataType": "int16",
        "scale": 0.1,
        "unit": "°C"
      },
      "display": { "precision": 1 },
      "role": "temperature"
    },
    {
      "id": "humidity_pct",
      "type": "sensor",
      "name": "Humidity",
      "category": "Environment",
      "source": {
        "bank": "broadcast",
        "byteOffset": 2,
        "dataType": "uint16",
        "scale": 0.1,
        "unit": "%"
      },
      "display": { "precision": 1 }
    },
    {
      "id": "battery_pct",
      "type": "sensor",
      "name": "Battery",
      "category": "Status",
      "source": {
        "bank": "broadcast",
        "byteOffset": 4,
        "dataType": "uint8",
        "unit": "%"
      },
      "display": { "precision": 0 }
    }
  ],
  "computedEntities": [
    {
      "id": "dew_point_c",
      "type": "sensor",
      "name": "Dew Point",
      "category": "Environment",
      "expression": "(243.04 * (ln(humidity_pct / 100) + ((17.625 * temperature_c) / (243.04 + temperature_c)))) / (17.625 - (ln(humidity_pct / 100) + ((17.625 * temperature_c) / (243.04 + temperature_c))))",
      "unit": "°C",
      "display": { "precision": 1 }
    },
    {
      "id": "vpd_kpa",
      "type": "sensor",
      "name": "VPD",
      "category": "Environment",
      "expression": "(1 - (humidity_pct / 100)) * 0.6108 * exp((17.27 * temperature_c) / (temperature_c + 237.3))",
      "unit": "kPa",
      "display": { "precision": 2 }
    }
  ],
  "storage": {
    "database": {
      "provider": "timescaledb",
      "defaultNamePattern": "FluxMonitor_{deviceId}"
    },
    "timeSeries": [
      { "entity": "temperature_c", "aggregate": "avg", "column": "temperature_c" },
      { "entity": "humidity_pct", "aggregate": "avg", "column": "humidity_pct" },
      { "entity": "dew_point_c", "aggregate": "avg", "column": "dew_point_c" },
      { "entity": "vpd_kpa", "aggregate": "avg", "column": "vpd_kpa" },
      { "entity": "battery_pct", "aggregate": "last", "column": "battery_pct" }
    ],
    "retention": {
      "raw": { "window": "24h" },
      "1m": { "window": "1y" },
      "5m": { "window": "2y" },
      "1h": { "window": "10y" }
    }
  },
  "ui": {
    "pages": {
      "monitor": {
        "sections": [
          {
            "type": "hero-metrics",
            "metrics": [
              { "entity": "temperature_c", "icon": "thermometer", "color": "orange" },
              { "entity": "humidity_pct", "icon": "activity", "color": "blue" },
              { "entity": "dew_point_c", "icon": "thermometer", "color": "teal" },
              { "entity": "vpd_kpa", "icon": "gauge", "color": "emerald" }
            ]
          },
          {
            "type": "parameter-table",
            "title": "Environment",
            "filter": { "categories": ["Environment"] }
          },
          {
            "type": "parameter-table",
            "title": "Status",
            "filter": { "categories": ["Status"] }
          }
        ]
      },
      "history": {
        "resolutions": [
          { "id": "1s", "label": "1 Second", "defaultWindow": "10m" },
          { "id": "1m", "label": "1 Minute", "defaultWindow": "1h" },
          { "id": "5m", "label": "5 Minutes", "defaultWindow": "24h" },
          { "id": "1h", "label": "1 Hour", "defaultWindow": "7d" }
        ],
        "charts": [
          {
            "title": "Temperature",
            "type": "line-chart",
            "traces": [
              { "entity": "temperature_c", "label": "Temperature", "color": "orange" },
              { "entity": "dew_point_c", "label": "Dew Point", "color": "teal" }
            ],
            "yAxis": { "unit": "°C", "label": "Temperature" }
          },
          {
            "title": "Humidity",
            "type": "line-chart",
            "traces": [
              { "entity": "humidity_pct", "label": "Humidity", "color": "blue" }
            ],
            "yAxis": { "unit": "%", "label": "Humidity", "domain": [0, 100] }
          },
          {
            "title": "VPD",
            "type": "line-chart",
            "traces": [
              { "entity": "vpd_kpa", "label": "VPD", "color": "emerald" }
            ],
            "yAxis": { "unit": "kPa", "label": "VPD" }
          },
          {
            "title": "Battery",
            "type": "line-chart",
            "traces": [
              { "entity": "battery_pct", "label": "Battery", "color": "amber" }
            ],
            "yAxis": { "unit": "%", "label": "Battery", "domain": [0, 100] }
          }
        ]
      },
      "dashboard": {
        "card": {
          "primaryMetric": "temperature_c",
          "secondaryMetrics": ["humidity_pct", "dew_point_c", "vpd_kpa"],
          "statusEntities": []
        }
      }
    }
  }
}
