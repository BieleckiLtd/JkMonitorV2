{
  "$schema": "https://FluxMonitor.local/schemas/device-definition-v1.json",
  "version": "1",

  "device": {
    "id": "pylontech-us-rs485",
    "name": "Pylontech US Series (RS485)",
    "manufacturer": "Pylontech",
    "model": "US2000 / US3000 / US5000",
    "category": "energy-storage",
    "description": "Pylontech US-series LiFePO4 battery modules with RS485 interface using the Pylon protocol V3.5. Supports US2000, US3000, US5000 and compatible models.",
    "icon": "battery",
    "documentationUrl": "https://github.com/BieleckiLtd/JkMonitorV2"
  },

  "connection": {
    "transport": {
      "type": "serial",
      "defaults": {
        "baudRate": 115200,
        "dataBits": 8,
        "parity": "none",
        "stopBits": 1,
        "readTimeoutMs": 2000,
        "writeTimeoutMs": 1000
      }
    },
    "protocol": {
      "type": "ascii-hex-framed",
      "settings": {
        "defaultSlaveAddress": 2,
        "interFrameDelayMs": 200,
        "retries": 1,
        "byteOrder": "big-endian",
        "asciiHexFrame": {
          "startByte": 126,
          "endByte": 13,
          "version": 32,
          "versionOffsetChars": 0,
          "addressOffsetChars": 2,
          "requestCommandSet": 70,
          "requestCommandSetOffsetChars": 4,
          "commandOffsetChars": 6,
          "lengthOffsetChars": 8,
          "payloadOffsetChars": 12,
          "lengthCharCount": 4,
          "checksumCharCount": 4,
          "lengthEncoding": "nibble-checksum-12bit",
          "frameChecksumType": "ones-complement-sum16",
          "responseSuccessCode": 0
        }
      }
    }
  },

  "dataSources": [
    {
      "id": "analog",
      "name": "Analog Values",
      "command": 66,
      "pollGroup": "fast",
      "requestInfo": "FF",
      "_comment": "CID2 0x42 — cell voltages, temperatures, current, voltage, capacity, cycles",
      "responseLayout": {
        "bufferSize": 96,
        "steps": [
          { "op": "skip", "size": 1 },
          { "op": "readVar", "var": "modules", "type": "u8" },
          { "op": "firstOf", "var": "modules", "steps": [
            { "op": "readVar", "var": "cells", "type": "u8", "writeTo": 64 },
            { "op": "copyArray", "count": "cells", "elementSize": 2, "writeTo": 0, "max": 32 },
            { "op": "readVar", "var": "temps", "type": "u8", "writeTo": 76 },
            { "op": "copyArray", "count": "temps", "elementSize": 2, "writeTo": 66, "max": 5 },
            { "op": "copy", "size": 2, "writeTo": 78 },
            { "op": "copy", "size": 2, "writeTo": 80 },
            { "op": "readVar", "var": "rc1", "type": "u16" },
            { "op": "readVar", "var": "udef", "type": "u8", "writeTo": 92 },
            { "op": "readVar", "var": "tc1", "type": "u16" },
            { "op": "copy", "size": 2, "writeTo": 90 },
            { "op": "branch", "var": "udef", "gt": 2,
              "then": [
                { "op": "readVar", "var": "rc2", "type": "u24", "writeTo": 82, "writeAs": "u32" },
                { "op": "skip", "size": 2 },
                { "op": "readVar", "var": "tc2", "type": "u24", "writeTo": 86, "writeAs": "u32" }
              ],
              "else": [
                { "op": "writeVar", "var": "rc1", "writeTo": 82, "writeAs": "u32" },
                { "op": "writeVar", "var": "tc1", "writeTo": 86, "writeAs": "u32" }
              ]
            }
          ]}
        ]
      }
    },
    {
      "id": "alarm",
      "name": "Alarm Info",
      "command": 68,
      "pollGroup": "fast",
      "optional": true,
      "requestInfo": "FF",
      "_comment": "CID2 0x44 — alarm flags per cell, temperature, current, voltage",
      "responseLayout": {
        "bufferSize": 16,
        "steps": [
          { "op": "skip", "size": 2 },
          { "op": "readVar", "var": "cells", "type": "u8", "writeTo": 0 },
          { "op": "readAnyNonZero", "count": "cells", "writeTo": 8 },
          { "op": "readVar", "var": "temps", "type": "u8", "writeTo": 1 },
          { "op": "readAnyNonZero", "count": "temps", "writeTo": 9 },
          { "op": "readByte", "writeTo": 10 },
          { "op": "readByte", "writeTo": 11 },
          { "op": "readByte", "writeTo": 12 },
          { "op": "readByte", "writeTo": 13 },
          { "op": "readByte", "writeTo": 14 },
          { "op": "readByte", "writeTo": 15 }
        ]
      }
    },
    {
      "id": "management",
      "name": "Management Info",
      "command": 146,
      "pollGroup": "slow",
      "optional": true,
      "requestInfo": "FF",
      "_comment": "CID2 0x92 — charge/discharge limits and enable flags",
      "responseLayout": {
        "bufferSize": 12,
        "steps": [
          { "op": "skip", "size": 1 },
          { "op": "copy", "size": 2, "writeTo": 0 },
          { "op": "copy", "size": 2, "writeTo": 2 },
          { "op": "copy", "size": 2, "writeTo": 4 },
          { "op": "copy", "size": 2, "writeTo": 6 },
          { "op": "readVar", "var": "status", "type": "u8" },
          { "op": "writeBit", "var": "status", "bit": 7, "writeTo": 8 },
          { "op": "writeBit", "var": "status", "bit": 6, "writeTo": 9 }
        ]
      }
    },
    {
      "id": "system",
      "name": "System Parameters",
      "command": 71,
      "pollGroup": "slow",
      "optional": true,
      "requestInfo": "FF",
      "_comment": "CID2 0x47 — voltage/current/temperature protection limits",
      "responseLayout": {
        "bufferSize": 24,
        "steps": [
          { "op": "skip", "size": 1 },
          { "op": "copy", "size": 24, "writeTo": 0 }
        ]
      }
    },
    {
      "id": "info",
      "name": "Manufacturer Info",
      "command": 81,
      "pollGroup": "slow",
      "optional": true,
      "requestInfo": "FF",
      "_comment": "CID2 0x51 — device name, software version, manufacturer",
      "responseLayout": {
        "bufferSize": 32,
        "steps": [
          { "op": "copy", "size": 10, "writeTo": 0 },
          { "op": "copy", "size": 2, "writeTo": 10 },
          { "op": "copyRemaining", "writeTo": 12, "max": 20 }
        ]
      }
    }
  ],

  "pollGroups": {
    "fast": {
      "intervalMs": 2000,
      "description": "Real-time sensor data — cell voltages, pack status, temperatures, alarms"
    },
    "slow": {
      "intervalMs": 60000,
      "description": "Configuration parameters, limits, and device info (slow-changing)"
    }
  },

  "entities": [
    {
      "_comment": "=== ANALOG — Cell Voltages ===",
      "id": "cell_voltages",
      "type": "cell_array",
      "name": "Cell Voltages",
      "category": "Cells",
      "source": {
        "bank": "analog",
        "byteOffset": 0,
        "elementDataType": "int16",
        "elementByteSize": 2,
        "maxElements": 32,
        "skipZero": true,
        "scale": 0.001,
        "unit": "V"
      },
      "display": { "precision": 3, "format": "number" },
      "role": "cell-voltages"
    },

    {
      "id": "cell_count",
      "type": "sensor",
      "name": "Cell Count",
      "category": "Diagnostics",
      "source": {
        "bank": "analog",
        "byteOffset": 64,
        "dataType": "uint8"
      },
      "hidden": true
    },

    {
      "_comment": "=== ANALOG — Temperatures ===",
      "id": "bms_temperature",
      "type": "sensor",
      "name": "BMS Temperature",
      "category": "Temperatures",
      "icon": "thermometer",
      "source": {
        "bank": "analog",
        "byteOffset": 66,
        "dataType": "int16",
        "scale": 0.1,
        "unit": "°C"
      },
      "display": { "precision": 1 },
      "role": "temperature",
      "_comment": "Kelvin*10 with offset 2731 → converted via computed entity"
    },
    {
      "id": "battery_temp_1",
      "type": "sensor",
      "name": "Cell Group Temp 1",
      "category": "Temperatures",
      "icon": "thermometer",
      "source": {
        "bank": "analog",
        "byteOffset": 68,
        "dataType": "int16",
        "scale": 0.1,
        "unit": "°C"
      },
      "display": { "precision": 1 },
      "role": "temperature"
    },
    {
      "id": "battery_temp_2",
      "type": "sensor",
      "name": "Cell Group Temp 2",
      "category": "Temperatures",
      "icon": "thermometer",
      "source": {
        "bank": "analog",
        "byteOffset": 70,
        "dataType": "int16",
        "scale": 0.1,
        "unit": "°C"
      },
      "display": { "precision": 1 },
      "role": "temperature"
    },
    {
      "id": "battery_temp_3",
      "type": "sensor",
      "name": "Cell Group Temp 3",
      "category": "Temperatures",
      "icon": "thermometer",
      "source": {
        "bank": "analog",
        "byteOffset": 72,
        "dataType": "int16",
        "scale": 0.1,
        "unit": "°C"
      },
      "display": { "precision": 1 },
      "hidden": true
    },
    {
      "id": "battery_temp_4",
      "type": "sensor",
      "name": "Cell Group Temp 4",
      "category": "Temperatures",
      "icon": "thermometer",
      "source": {
        "bank": "analog",
        "byteOffset": 74,
        "dataType": "int16",
        "scale": 0.1,
        "unit": "°C"
      },
      "display": { "precision": 1 },
      "hidden": true
    },

    {
      "_comment": "=== ANALOG — Pack Status ===",
      "id": "current",
      "type": "sensor",
      "name": "Current",
      "category": "Pack Status",
      "icon": "activity",
      "source": {
        "bank": "analog",
        "byteOffset": 78,
        "dataType": "int16",
        "scale": 0.1,
        "unit": "A"
      },
      "display": { "precision": 1 },
      "role": "current"
    },
    {
      "id": "total_voltage",
      "type": "sensor",
      "name": "Total Voltage",
      "category": "Pack Status",
      "icon": "zap",
      "source": {
        "bank": "analog",
        "byteOffset": 80,
        "dataType": "uint16",
        "scale": 0.001,
        "unit": "V"
      },
      "display": { "precision": 2 },
      "role": "total-voltage"
    },
    {
      "id": "remaining_capacity",
      "type": "sensor",
      "name": "Remaining Capacity",
      "category": "Pack Status",
      "icon": "battery",
      "source": {
        "bank": "analog",
        "byteOffset": 82,
        "dataType": "uint32",
        "scale": 0.001,
        "unit": "Ah"
      },
      "display": { "precision": 2 }
    },
    {
      "id": "total_capacity",
      "type": "sensor",
      "name": "Total Capacity",
      "category": "Pack Status",
      "source": {
        "bank": "analog",
        "byteOffset": 86,
        "dataType": "uint32",
        "scale": 0.001,
        "unit": "Ah"
      },
      "display": { "precision": 2 },
      "hidden": true
    },
    {
      "id": "cycle_count",
      "type": "sensor",
      "name": "Cycle Count",
      "category": "Pack Status",
      "source": {
        "bank": "analog",
        "byteOffset": 90,
        "dataType": "uint16"
      },
      "display": { "precision": 0 },
      "role": "cycle-count"
    },

    {
      "_comment": "=== ALARM — Individual Flags ===",
      "id": "cell_voltage_alarm",
      "type": "binary_sensor",
      "name": "Cell Voltage Alarm",
      "category": "Alarms",
      "source": {
        "bank": "alarm",
        "byteOffset": 8,
        "dataType": "uint8",
        "trueValue": 1
      },
      "hidden": true
    },
    {
      "id": "temperature_alarm",
      "type": "binary_sensor",
      "name": "Temperature Alarm",
      "category": "Alarms",
      "source": {
        "bank": "alarm",
        "byteOffset": 9,
        "dataType": "uint8",
        "trueValue": 1
      },
      "hidden": true
    },
    {
      "id": "current_alarm",
      "type": "binary_sensor",
      "name": "Current Alarm",
      "category": "Alarms",
      "source": {
        "bank": "alarm",
        "byteOffset": 10,
        "dataType": "uint8",
        "trueValue": 1
      },
      "hidden": true
    },
    {
      "id": "voltage_alarm",
      "type": "binary_sensor",
      "name": "Voltage Alarm",
      "category": "Alarms",
      "source": {
        "bank": "alarm",
        "byteOffset": 11,
        "dataType": "uint8",
        "trueValue": 1
      },
      "hidden": true
    },

    {
      "_comment": "=== MANAGEMENT — Charge/Discharge Status ===",
      "id": "charging_enabled",
      "type": "binary_sensor",
      "name": "Charging",
      "category": "Status",
      "source": {
        "bank": "management",
        "byteOffset": 8,
        "dataType": "uint8",
        "trueValue": 1
      },
      "role": "charging-enabled"
    },
    {
      "id": "discharging_enabled",
      "type": "binary_sensor",
      "name": "Discharging",
      "category": "Status",
      "source": {
        "bank": "management",
        "byteOffset": 9,
        "dataType": "uint8",
        "trueValue": 1
      },
      "role": "discharging-enabled"
    },

    {
      "_comment": "=== MANAGEMENT — Limits ===",
      "id": "charge_voltage_limit",
      "type": "sensor",
      "name": "Charge Voltage Limit",
      "category": "Limits",
      "source": {
        "bank": "management",
        "byteOffset": 0,
        "dataType": "uint16",
        "scale": 0.001,
        "unit": "V"
      },
      "display": { "precision": 2 }
    },
    {
      "id": "discharge_voltage_limit",
      "type": "sensor",
      "name": "Discharge Voltage Limit",
      "category": "Limits",
      "source": {
        "bank": "management",
        "byteOffset": 2,
        "dataType": "uint16",
        "scale": 0.001,
        "unit": "V"
      },
      "display": { "precision": 2 }
    },
    {
      "id": "charge_current_limit",
      "type": "sensor",
      "name": "Charge Current Limit",
      "category": "Limits",
      "source": {
        "bank": "management",
        "byteOffset": 4,
        "dataType": "int16",
        "scale": 0.1,
        "unit": "A"
      },
      "display": { "precision": 1 }
    },
    {
      "id": "discharge_current_limit",
      "type": "sensor",
      "name": "Discharge Current Limit",
      "category": "Limits",
      "source": {
        "bank": "management",
        "byteOffset": 6,
        "dataType": "int16",
        "scale": 0.1,
        "unit": "A"
      },
      "display": { "precision": 1 }
    },

    {
      "_comment": "=== SYSTEM — Protection Limits ===",
      "id": "cell_high_voltage_limit",
      "type": "sensor",
      "name": "Cell High Voltage Limit",
      "category": "Protection",
      "source": {
        "bank": "system",
        "byteOffset": 0,
        "dataType": "uint16",
        "scale": 0.001,
        "unit": "V"
      },
      "display": { "precision": 3 }
    },
    {
      "id": "cell_low_voltage_limit",
      "type": "sensor",
      "name": "Cell Low Voltage Limit",
      "category": "Protection",
      "source": {
        "bank": "system",
        "byteOffset": 2,
        "dataType": "uint16",
        "scale": 0.001,
        "unit": "V"
      },
      "display": { "precision": 3 }
    },

    {
      "_comment": "=== INFO — Device Information ===",
      "id": "device_name",
      "type": "text",
      "name": "Device Name",
      "category": "Device Info",
      "source": {
        "bank": "info",
        "byteOffset": 0,
        "dataType": "ascii",
        "length": 10
      }
    },
    {
      "id": "manufacturer_name",
      "type": "text",
      "name": "Manufacturer",
      "category": "Device Info",
      "source": {
        "bank": "info",
        "byteOffset": 12,
        "dataType": "ascii",
        "length": 20
      }
    }
  ],

  "computedEntities": [
    {
      "id": "state_of_charge",
      "type": "sensor",
      "name": "State of Charge",
      "category": "Pack Status",
      "expression": "(remaining_capacity / total_capacity) * 100",
      "unit": "%",
      "display": { "precision": 0 },
      "role": "state-of-charge"
    },
    {
      "id": "computed_power",
      "type": "sensor",
      "name": "Power",
      "category": "Pack Status",
      "expression": "total_voltage * current",
      "unit": "W",
      "display": { "precision": 0 },
      "role": "power"
    },
    {
      "id": "bms_temperature_celsius",
      "type": "sensor",
      "name": "BMS Temperature",
      "category": "Temperatures",
      "expression": "bms_temperature - 273.1",
      "unit": "°C",
      "display": { "precision": 1 }
    },
    {
      "id": "battery_temp_1_celsius",
      "type": "sensor",
      "name": "Cell Group Temp 1",
      "category": "Temperatures",
      "expression": "battery_temp_1 - 273.1",
      "unit": "°C",
      "display": { "precision": 1 }
    },
    {
      "id": "battery_temp_2_celsius",
      "type": "sensor",
      "name": "Cell Group Temp 2",
      "category": "Temperatures",
      "expression": "battery_temp_2 - 273.1",
      "unit": "°C",
      "display": { "precision": 1 }
    },
    {
      "id": "min_cell_voltage",
      "type": "sensor",
      "name": "Min Cell Voltage",
      "category": "Cells",
      "expression": "min(cell_voltages)",
      "unit": "V",
      "display": { "precision": 3 }
    },
    {
      "id": "max_cell_voltage",
      "type": "sensor",
      "name": "Max Cell Voltage",
      "category": "Cells",
      "expression": "max(cell_voltages)",
      "unit": "V",
      "display": { "precision": 3 }
    },
    {
      "id": "avg_cell_voltage",
      "type": "sensor",
      "name": "Avg Cell Voltage",
      "category": "Cells",
      "expression": "avg(cell_voltages)",
      "unit": "V",
      "display": { "precision": 3 }
    },
    {
      "id": "delta_cell_voltage",
      "type": "sensor",
      "name": "Cell Delta Voltage",
      "category": "Cells",
      "expression": "max(cell_voltages) - min(cell_voltages)",
      "unit": "V",
      "display": { "precision": 3 }
    },
    {
      "id": "alarm_flags",
      "type": "sensor",
      "name": "Alarm Flags",
      "category": "Diagnostics",
      "expression": "cell_voltage_alarm * 1 + temperature_alarm * 2 + current_alarm * 4 + voltage_alarm * 8",
      "display": { "format": "hex" },
      "role": "alarm-flags",
      "hidden": true
    }
  ],

  "alarms": {
    "source": "alarm_flags",
    "type": "bitmask",
    "bits": [
      { "bit": 0, "name": "Cell voltage alarm",        "severity": "critical" },
      { "bit": 1, "name": "Temperature alarm",          "severity": "critical" },
      { "bit": 2, "name": "Current alarm",              "severity": "critical" },
      { "bit": 3, "name": "Module voltage alarm",       "severity": "critical" },
      { "bit": 4, "name": "Status alarm 1",             "severity": "warning" },
      { "bit": 5, "name": "Status alarm 2",             "severity": "warning" },
      { "bit": 6, "name": "Status alarm 3",             "severity": "warning" },
      { "bit": 7, "name": "Status alarm 4",             "severity": "warning" }
    ]
  },

  "storage": {
    "database": {
      "provider": "timescaledb",
      "defaultNamePattern": "FluxMonitor_{deviceId}"
    },
    "timeSeries": [
      { "entity": "total_voltage",      "aggregate": "avg", "column": "total_voltage_v" },
      { "entity": "current",            "aggregate": "avg", "column": "current_a" },
      { "entity": "computed_power",     "aggregate": "avg", "column": "power_w" },
      { "entity": "state_of_charge",    "aggregate": "last", "column": "soc_pct" },
      { "entity": "min_cell_voltage",   "aggregate": "min", "column": "min_cell_v" },
      { "entity": "max_cell_voltage",   "aggregate": "max", "column": "max_cell_v" },
      { "entity": "delta_cell_voltage", "aggregate": "avg", "column": "delta_cell_v" },
      { "entity": "bms_temperature_celsius", "aggregate": "avg", "column": "bms_temp_c" },
      { "entity": "battery_temp_1_celsius",  "aggregate": "avg", "column": "battery_temp_c" }
    ],
    "cellVoltages": {
      "entity": "cell_voltages",
      "aggregate": "avg"
    },
    "retention": {
      "raw":  { "window": "24h" },
      "1m":   { "window": "1y" },
      "5m":   { "window": "1y" },
      "1h":   { "window": "10y" }
    }
  },

  "ui": {
    "pages": {
      "monitor": {
        "sections": [
          {
            "type": "hero-metrics",
            "metrics": [
              { "entity": "total_voltage",    "icon": "zap",      "color": "emerald" },
              { "entity": "current",          "icon": "activity",  "color": "blue" },
              { "entity": "computed_power",   "icon": "gauge",     "color": "amber" },
              { "entity": "state_of_charge",  "icon": "battery",   "color": "green" }
            ]
          },
          {
            "type": "status-indicators",
            "entities": ["charging_enabled", "discharging_enabled"]
          },
          {
            "type": "cell-chart",
            "entity": "cell_voltages",
            "showStats": true,
            "showDelta": true,
            "stats": ["min_cell_voltage", "max_cell_voltage", "avg_cell_voltage", "delta_cell_voltage"]
          },
          {
            "type": "parameter-table",
            "title": "Limits",
            "filter": { "categories": ["Limits", "Protection"] },
            "groupBy": "category"
          },
          {
            "type": "parameter-table",
            "title": "Device Info",
            "filter": { "categories": ["Device Info"] }
          }
        ]
      },
      "history": {
        "resolutions": [
          { "id": "1s", "label": "1 Second",  "defaultWindow": "10m" },
          { "id": "1m", "label": "1 Minute",  "defaultWindow": "1h" },
          { "id": "5m", "label": "5 Minutes", "defaultWindow": "24h" },
          { "id": "1h", "label": "1 Hour",    "defaultWindow": "7d" }
        ],
        "charts": [
          {
            "title": "Current",
            "type": "line-chart",
            "traces": [
              { "entity": "current", "label": "Current", "color": "blue" }
            ],
            "yAxis": { "unit": "A", "label": "Current" }
          },
          {
            "title": "Energy",
            "type": "area-chart",
            "traces": [
              { "entity": "computed_power", "color": "amber", "positiveLabel": "Charging", "negativeLabel": "Discharging" }
            ],
            "yAxis": { "unit": "W", "label": "Power" },
            "showEnergyTotals": true
          },
          {
            "title": "State of Charge",
            "type": "line-chart",
            "traces": [
              { "entity": "state_of_charge", "label": "SOC", "color": "green" }
            ],
            "yAxis": { "unit": "%", "label": "SOC", "domain": [0, 100] }
          },
          {
            "title": "Temperatures",
            "type": "line-chart",
            "traces": [
              { "entity": "bms_temperature_celsius",   "label": "BMS",          "color": "red" },
              { "entity": "battery_temp_1_celsius",    "label": "Cell Group 1", "color": "orange" },
              { "entity": "battery_temp_2_celsius",    "label": "Cell Group 2", "color": "yellow" }
            ],
            "yAxis": { "unit": "°C", "label": "Temperature" }
          },
          {
            "title": "Cell Voltage Spread",
            "type": "line-chart",
            "traces": [
              { "entity": "min_cell_voltage", "label": "Min",   "color": "red" },
              { "entity": "max_cell_voltage", "label": "Max",   "color": "emerald" },
              { "entity": "avg_cell_voltage", "label": "Avg",   "color": "blue", "dashed": true }
            ],
            "yAxis": { "unit": "V", "label": "Cell Voltage" }
          },
          {
            "title": "Cell Voltages",
            "type": "multi-cell-chart",
            "entity": "cell_voltages",
            "selectable": true
          }
        ]
      },
      "dashboard": {
        "card": {
          "primaryMetric": "state_of_charge",
          "secondaryMetrics": ["total_voltage", "current", "computed_power"],
          "statusEntities": ["charging_enabled", "discharging_enabled"]
        }
      }
    }
  },

  "notifications": {
    "rules": [
      {
        "id": "low-soc",
        "name": "Low Battery",
        "condition": { "entity": "state_of_charge", "operator": "<", "value": 10 },
        "severity": "critical",
        "message": "Battery critically low: {state_of_charge}%",
        "cooldownMinutes": 15
      },
      {
        "id": "high-temp",
        "name": "High Temperature",
        "condition": { "entity": "bms_temperature_celsius", "operator": ">", "value": 50 },
        "severity": "warning",
        "message": "BMS temperature high: {bms_temperature_celsius}°C",
        "cooldownMinutes": 30
      },
      {
        "id": "high-delta",
        "name": "Cell Imbalance",
        "condition": { "entity": "delta_cell_voltage", "operator": ">", "value": 0.05 },
        "severity": "warning",
        "message": "Cell imbalance detected: delta {delta_cell_voltage}V",
        "cooldownMinutes": 60
      },
      {
        "id": "alarm-active",
        "name": "Device Alarm",
        "condition": { "entity": "alarm_flags", "operator": "!=", "value": 0 },
        "severity": "critical",
        "message": "Active device alarm detected",
        "cooldownMinutes": 5
      }
    ]
  }
}
