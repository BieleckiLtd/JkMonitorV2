{
  "$schema": "https://FluxMonitor.local/schemas/device-definition-v1.json",
  "version": "1",

  "device": {
    "id": "jk-inverter-bms-pylon",
    "name": "JK BMS (Pylon RS485)",
    "manufacturer": "JK / Shenzhen Jikong",
    "model": "PB2A16S Series",
    "category": "energy-storage",
    "description": "JK BMS with Pylon-compatible RS485 interface. Uses JK-proprietary CID2 commands (0x61 telemetry, 0x63 limits) over standard Pylon ASCII-hex framing at 9600 baud.",
    "icon": "battery",
    "documentationUrl": "https://github.com/BieleckiLtd/JkMonitorV2"
  },

  "connection": {
    "transport": {
      "type": "serial",
      "defaults": {
        "baudRate": 9600,
        "dataBits": 8,
        "parity": "none",
        "stopBits": 1,
        "readTimeoutMs": 2000,
        "writeTimeoutMs": 1000
      }
    },
    "protocol": {
      "type": "ascii-hex-framed",
      "settings": {
        "defaultSlaveAddress": 2,
        "interFrameDelayMs": 200,
        "retries": 1,
        "byteOrder": "big-endian",
        "asciiHexFrame": {
          "startByte": 126,
          "endByte": 13,
          "version": 32,
          "versionOffsetChars": 0,
          "addressOffsetChars": 2,
          "requestCommandSet": 70,
          "requestCommandSetOffsetChars": 4,
          "commandOffsetChars": 6,
          "lengthOffsetChars": 8,
          "payloadOffsetChars": 12,
          "lengthCharCount": 4,
          "checksumCharCount": 4,
          "lengthEncoding": "nibble-checksum-12bit",
          "frameChecksumType": "ones-complement-sum16",
          "responseSuccessCode": 0
        }
      }
    }
  },

  "dataSources": [
    {
      "id": "telemetry",
      "name": "Telemetry",
      "command": 97,
      "pollGroup": "fast",
      "_comment": "CID2 0x61 — JK proprietary: pack voltage, current, SOC, max/min cell, temperatures. 49-byte payload: [packV:u16][current:i16][soc:u8][?:6B][maxCellV:u16][?:1B][maxCellId:u8][minCellV:u16][?:1B][minCellId:u8][t1:u16][t2:u16][?:2B][t3:u16][remaining]",
      "responseLayout": {
        "bufferSize": 32,
        "steps": [
          { "op": "copy", "size": 2, "writeTo": 0 },
          { "op": "copy", "size": 2, "writeTo": 2 },
          { "op": "readByte", "writeTo": 4 },
          { "op": "skip", "size": 6 },
          { "op": "copy", "size": 2, "writeTo": 6 },
          { "op": "skip", "size": 1 },
          { "op": "readByte", "writeTo": 16 },
          { "op": "copy", "size": 2, "writeTo": 8 },
          { "op": "skip", "size": 1 },
          { "op": "readByte", "writeTo": 17 },
          { "op": "copy", "size": 2, "writeTo": 10 },
          { "op": "copy", "size": 2, "writeTo": 12 },
          { "op": "skip", "size": 2 },
          { "op": "copy", "size": 2, "writeTo": 14 }
        ]
      }
    },
    {
      "id": "limits",
      "name": "Charge/Discharge Limits",
      "command": 99,
      "pollGroup": "slow",
      "optional": true,
      "_comment": "CID2 0x63 — JK proprietary: voltage/current limits and enable flags. 9-byte payload: [chargeVlim:u16][dischargeVlim:u16][chargeCurLim:u16][dischargeCurLim:u16][statusByte]",
      "responseLayout": {
        "bufferSize": 12,
        "steps": [
          { "op": "copy", "size": 2, "writeTo": 0 },
          { "op": "copy", "size": 2, "writeTo": 2 },
          { "op": "copy", "size": 2, "writeTo": 4 },
          { "op": "copy", "size": 2, "writeTo": 6 },
          { "op": "readVar", "var": "status", "type": "u8" },
          { "op": "writeBit", "var": "status", "bit": 7, "writeTo": 8 },
          { "op": "writeBit", "var": "status", "bit": 6, "writeTo": 9 }
        ]
      }
    }
  ],

  "pollGroups": {
    "fast": {
      "intervalMs": 2000,
      "description": "Real-time telemetry — pack voltage, current, SOC, temperatures"
    },
    "slow": {
      "intervalMs": 60000,
      "description": "Charge/discharge limits (slow-changing)"
    }
  },

  "entities": [
    {
      "_comment": "=== TELEMETRY — Pack Status ===",
      "id": "total_voltage",
      "type": "sensor",
      "name": "Total Voltage",
      "category": "Pack Status",
      "icon": "zap",
      "source": {
        "bank": "telemetry",
        "byteOffset": 0,
        "dataType": "uint16",
        "scale": 0.001,
        "unit": "V"
      },
      "display": { "precision": 2 },
      "role": "total-voltage"
    },
    {
      "id": "current",
      "type": "sensor",
      "name": "Current",
      "category": "Pack Status",
      "icon": "activity",
      "source": {
        "bank": "telemetry",
        "byteOffset": 2,
        "dataType": "int16",
        "scale": 0.1,
        "unit": "A"
      },
      "display": { "precision": 1 },
      "role": "current"
    },
    {
      "id": "state_of_charge",
      "type": "sensor",
      "name": "State of Charge",
      "category": "Pack Status",
      "icon": "battery",
      "source": {
        "bank": "telemetry",
        "byteOffset": 4,
        "dataType": "uint8",
        "unit": "%"
      },
      "display": { "precision": 0 },
      "role": "state-of-charge"
    },

    {
      "_comment": "=== TELEMETRY — Cell Voltages (max/min from BMS summary) ===",
      "id": "max_cell_voltage",
      "type": "sensor",
      "name": "Max Cell Voltage",
      "category": "Cells",
      "source": {
        "bank": "telemetry",
        "byteOffset": 6,
        "dataType": "uint16",
        "scale": 0.001,
        "unit": "V"
      },
      "display": { "precision": 3 }
    },
    {
      "id": "min_cell_voltage",
      "type": "sensor",
      "name": "Min Cell Voltage",
      "category": "Cells",
      "source": {
        "bank": "telemetry",
        "byteOffset": 8,
        "dataType": "uint16",
        "scale": 0.001,
        "unit": "V"
      },
      "display": { "precision": 3 }
    },

    {
      "_comment": "=== TELEMETRY — Temperatures (Kelvin×10 raw, converted via computed) ===",
      "id": "temp_bms_raw",
      "type": "sensor",
      "name": "BMS Temperature (raw)",
      "category": "Temperatures",
      "icon": "thermometer",
      "source": {
        "bank": "telemetry",
        "byteOffset": 10,
        "dataType": "uint16",
        "scale": 0.1,
        "unit": "K"
      },
      "display": { "precision": 1 },
      "hidden": true
    },
    {
      "id": "temp_1_raw",
      "type": "sensor",
      "name": "Cell Group Temp 1 (raw)",
      "category": "Temperatures",
      "icon": "thermometer",
      "source": {
        "bank": "telemetry",
        "byteOffset": 12,
        "dataType": "uint16",
        "scale": 0.1,
        "unit": "K"
      },
      "display": { "precision": 1 },
      "hidden": true
    },
    {
      "id": "temp_2_raw",
      "type": "sensor",
      "name": "Cell Group Temp 2 (raw)",
      "category": "Temperatures",
      "icon": "thermometer",
      "source": {
        "bank": "telemetry",
        "byteOffset": 14,
        "dataType": "uint16",
        "scale": 0.1,
        "unit": "K"
      },
      "display": { "precision": 1 },
      "hidden": true
    },

    {
      "_comment": "=== LIMITS ===",
      "id": "charging_enabled",
      "type": "binary_sensor",
      "name": "Charging",
      "category": "Status",
      "source": {
        "bank": "limits",
        "byteOffset": 8,
        "dataType": "uint8",
        "trueValue": 1
      },
      "role": "charging-enabled"
    },
    {
      "id": "discharging_enabled",
      "type": "binary_sensor",
      "name": "Discharging",
      "category": "Status",
      "source": {
        "bank": "limits",
        "byteOffset": 9,
        "dataType": "uint8",
        "trueValue": 1
      },
      "role": "discharging-enabled"
    },
    {
      "id": "charge_voltage_limit",
      "type": "sensor",
      "name": "Charge Voltage Limit",
      "category": "Limits",
      "source": {
        "bank": "limits",
        "byteOffset": 0,
        "dataType": "uint16",
        "scale": 0.001,
        "unit": "V"
      },
      "display": { "precision": 2 }
    },
    {
      "id": "discharge_voltage_limit",
      "type": "sensor",
      "name": "Discharge Voltage Limit",
      "category": "Limits",
      "source": {
        "bank": "limits",
        "byteOffset": 2,
        "dataType": "uint16",
        "scale": 0.001,
        "unit": "V"
      },
      "display": { "precision": 2 }
    },
    {
      "id": "charge_current_limit",
      "type": "sensor",
      "name": "Charge Current Limit",
      "category": "Limits",
      "source": {
        "bank": "limits",
        "byteOffset": 4,
        "dataType": "int16",
        "scale": 0.1,
        "unit": "A"
      },
      "display": { "precision": 1 }
    },
    {
      "id": "discharge_current_limit",
      "type": "sensor",
      "name": "Discharge Current Limit",
      "category": "Limits",
      "source": {
        "bank": "limits",
        "byteOffset": 6,
        "dataType": "int16",
        "scale": 0.1,
        "unit": "A"
      },
      "display": { "precision": 1 }
    }
  ],

  "computedEntities": [
    {
      "id": "computed_power",
      "type": "sensor",
      "name": "Power",
      "category": "Pack Status",
      "expression": "total_voltage * current",
      "unit": "W",
      "display": { "precision": 0 },
      "role": "power"
    },
    {
      "id": "bms_temperature_celsius",
      "type": "sensor",
      "name": "BMS Temperature",
      "category": "Temperatures",
      "expression": "temp_bms_raw - 273.1",
      "unit": "°C",
      "display": { "precision": 1 },
      "role": "temperature"
    },
    {
      "id": "battery_temp_1_celsius",
      "type": "sensor",
      "name": "Cell Group Temp 1",
      "category": "Temperatures",
      "expression": "temp_1_raw - 273.1",
      "unit": "°C",
      "display": { "precision": 1 }
    },
    {
      "id": "battery_temp_2_celsius",
      "type": "sensor",
      "name": "Cell Group Temp 2",
      "category": "Temperatures",
      "expression": "temp_2_raw - 273.1",
      "unit": "°C",
      "display": { "precision": 1 }
    },
    {
      "id": "delta_cell_voltage",
      "type": "sensor",
      "name": "Cell Delta Voltage",
      "category": "Cells",
      "expression": "max_cell_voltage - min_cell_voltage",
      "unit": "V",
      "display": { "precision": 3 }
    }
  ],

  "storage": {
    "database": {
      "provider": "timescaledb",
      "defaultNamePattern": "FluxMonitor_{deviceId}"
    },
    "timeSeries": [
      { "entity": "total_voltage",      "aggregate": "avg", "column": "total_voltage_v" },
      { "entity": "current",            "aggregate": "avg", "column": "current_a" },
      { "entity": "computed_power",     "aggregate": "avg", "column": "power_w" },
      { "entity": "state_of_charge",    "aggregate": "last", "column": "soc_pct" },
      { "entity": "min_cell_voltage",   "aggregate": "min", "column": "min_cell_v" },
      { "entity": "max_cell_voltage",   "aggregate": "max", "column": "max_cell_v" },
      { "entity": "delta_cell_voltage", "aggregate": "avg", "column": "delta_cell_v" },
      { "entity": "bms_temperature_celsius", "aggregate": "avg", "column": "bms_temp_c" },
      { "entity": "battery_temp_1_celsius",  "aggregate": "avg", "column": "battery_temp_c" }
    ],
    "retention": {
      "raw":  { "window": "24h" },
      "1m":   { "window": "1y" },
      "5m":   { "window": "1y" },
      "1h":   { "window": "10y" }
    }
  },

  "ui": {
    "pages": {
      "monitor": {
        "sections": [
          {
            "type": "hero-metrics",
            "metrics": [
              { "entity": "total_voltage",    "icon": "zap",      "color": "emerald" },
              { "entity": "current",          "icon": "activity",  "color": "blue" },
              { "entity": "computed_power",   "icon": "gauge",     "color": "amber" },
              { "entity": "state_of_charge",  "icon": "battery",   "color": "green" }
            ]
          },
          {
            "type": "status-indicators",
            "entities": ["charging_enabled", "discharging_enabled"]
          },
          {
            "type": "parameter-table",
            "title": "Cell Voltages",
            "filter": { "categories": ["Cells"] },
            "groupBy": "category"
          },
          {
            "type": "parameter-table",
            "title": "Temperatures",
            "filter": { "categories": ["Temperatures"] },
            "groupBy": "category"
          },
          {
            "type": "parameter-table",
            "title": "Limits",
            "filter": { "categories": ["Limits"] },
            "groupBy": "category"
          }
        ]
      },
      "history": {
        "resolutions": [
          { "id": "1s", "label": "1 Second",  "defaultWindow": "10m" },
          { "id": "1m", "label": "1 Minute",  "defaultWindow": "1h" },
          { "id": "5m", "label": "5 Minutes", "defaultWindow": "24h" },
          { "id": "1h", "label": "1 Hour",    "defaultWindow": "7d" }
        ],
        "charts": [
          {
            "title": "Current",
            "type": "line-chart",
            "traces": [
              { "entity": "current", "label": "Current", "color": "blue" }
            ],
            "yAxis": { "unit": "A", "label": "Current" }
          },
          {
            "title": "Energy",
            "type": "area-chart",
            "traces": [
              { "entity": "computed_power", "color": "amber", "positiveLabel": "Charging", "negativeLabel": "Discharging" }
            ],
            "yAxis": { "unit": "W", "label": "Power" },
            "showEnergyTotals": true
          },
          {
            "title": "State of Charge",
            "type": "line-chart",
            "traces": [
              { "entity": "state_of_charge", "label": "SOC", "color": "green" }
            ],
            "yAxis": { "unit": "%", "label": "SOC", "domain": [0, 100] }
          },
          {
            "title": "Temperatures",
            "type": "line-chart",
            "traces": [
              { "entity": "bms_temperature_celsius",   "label": "BMS",          "color": "red" },
              { "entity": "battery_temp_1_celsius",    "label": "Cell Group 1", "color": "orange" },
              { "entity": "battery_temp_2_celsius",    "label": "Cell Group 2", "color": "yellow" }
            ],
            "yAxis": { "unit": "°C", "label": "Temperature" }
          },
          {
            "title": "Cell Voltage Spread",
            "type": "line-chart",
            "traces": [
              { "entity": "min_cell_voltage", "label": "Min",   "color": "red" },
              { "entity": "max_cell_voltage", "label": "Max",   "color": "emerald" }
            ],
            "yAxis": { "unit": "V", "label": "Cell Voltage" }
          }
        ]
      },
      "dashboard": {
        "card": {
          "primaryMetric": "state_of_charge",
          "secondaryMetrics": ["total_voltage", "current", "computed_power"],
          "statusEntities": ["charging_enabled", "discharging_enabled"]
        }
      }
    }
  },

  "notifications": {
    "rules": [
      {
        "id": "low-soc",
        "name": "Low Battery",
        "condition": { "entity": "state_of_charge", "operator": "<", "value": 10 },
        "severity": "critical",
        "message": "Battery critically low: {state_of_charge}%",
        "cooldownMinutes": 15
      },
      {
        "id": "high-temp",
        "name": "High Temperature",
        "condition": { "entity": "bms_temperature_celsius", "operator": ">", "value": 50 },
        "severity": "warning",
        "message": "BMS temperature high: {bms_temperature_celsius}°C",
        "cooldownMinutes": 30
      },
      {
        "id": "high-delta",
        "name": "Cell Imbalance",
        "condition": { "entity": "delta_cell_voltage", "operator": ">", "value": 0.05 },
        "severity": "warning",
        "message": "Cell imbalance detected: delta {delta_cell_voltage}V",
        "cooldownMinutes": 60
      }
    ]
  }
}
